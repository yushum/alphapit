# Development only: copy to .env and change the password. Never use in production.
# This Compose file inserts these values directly into a PostgreSQL URI, so use
# only URL-safe letters, digits, underscores or hyphens for all three values.
# Other characters require a separately URI-encoded DATABASE_URL configuration;
# do not percent-encode POSTGRES_PASSWORD here (Postgres uses its literal value).
POSTGRES_DB=alphapit
POSTGRES_USER=alphapit
POSTGRES_PASSWORD=change_me_local_only
